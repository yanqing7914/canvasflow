      "toolCalls": ["family.resolve-members", "flight.get-status"],
      "expectedToolErrors": { "flight.get-status": "PROVIDER_TIMEOUT" },
      "statePatch": { "passengers": { "memberIds": ["mom"], "names": ["妈妈"], "confirmedOnboard": false } },
      "expectedPhase": "preparing",
      "expectedTaskRevision": 1,
