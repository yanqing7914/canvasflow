      "event": { "eventId": "timeout-flight-provider", "type": "provider.timeout", "provider": "flight.get-status", "timestamp": "2026-07-22T20:01:01+08:00" },
      "toolCalls": ["flight.get-status"],
      "expectedToolErrors": { "flight.get-status": "PROVIDER_TIMEOUT" },
      "expectedUI": { "generatedBy": "fallback", "primaryComponent": "status-banner", "priority": "high", "fallback": { "title": "航班数据暂时不可用", "message": "已保留乘客和航班输入，可稍后重试。" } },
      "expectedPhase": "preparing",
      "expectedTaskRevision": 1,
