# Copy to apps/demo/.env.local (git-ignored) and fill in your own keys.
# With both blank, the route map degrades to the offline sketch — no map SDK
# is loaded and no request leaves the browser.

# Web (JS API) key. This is bundled into the browser build, so it MUST have a
# domain allowlist configured in the AMap console (localhost, 127.0.0.1, and
# your demo host). Only Vite's VITE_-prefixed vars reach the client.
VITE_AMAP_JS_KEY=

# Optional ordered key ring for competition recovery. When set, it takes
# precedence over VITE_AMAP_JS_KEY and is tried from left to right. Values are
# comma-separated Web JS API keys; keep the file local and domain-restrict each
# key in the AMap console. The single-key variable remains compatible.
VITE_AMAP_JS_KEYS=

# Local sherpa KWS/VAD is the default wake path. Set this kill switch to 0 only
# on a host that cannot serve the voice assets or the required COOP/COEP headers.
VITE_LOCAL_WAKE_ENABLED=1

# Security code (jscode) for the Web service. Used server-side only: the
# /_AMapService proxy appends it to upstream requests. It has no VITE_ prefix,
# so Vite never injects it into the browser bundle.
AMAP_SECURITY_JS_CODE=

# Optional shared-PCM ASR provider. It receives raw PCM16LE at 16 kHz mono and
# must return JSON: {"text":"...","confidence":0.0}.
CANVASFLOW_ASR_URL=
